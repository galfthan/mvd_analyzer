# systemd unit for mvd-api (REST + Discord key portal).
#
# EDIT before use:
#   - User=/Group=       a dedicated unprivileged account (create it).
#   - WorkingDirectory=  where the binary + cache live.
#   - ExecStart path     where `make build` placed dist/mvd-api.
#   - -portal-base-url   your public https origin (matches the Caddy domain).
#   - flag values        cache budget / parse concurrency / rate classes.
#
# Secrets (DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, PORTAL_COOKIE_SECRET)
# come from EnvironmentFile — NEVER put them in ExecStart flags: flags are
# visible in `ps` (PLAN-hosting D9). The file is root-owned 0600.
#
# Install: copy to /etc/systemd/system/mvd-api.service, then
#   systemctl daemon-reload && systemctl enable --now mvd-api

[Unit]
Description=mvd-api — QuakeWorld MVD analytics REST API + Discord key portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mvd
Group=mvd
WorkingDirectory=/opt/mvd

# Discord client id/secret + portal cookie HMAC secret arrive here, not on
# the command line. See deploy/README.md for the file's contents.
EnvironmentFile=/etc/mvd/secrets.env

# Where the .bsp files live. LOS (/v1/demos/{id}/los) and airgibs need the
# map's BSP; there is NO -bsp-dir flag, so this env var is how you point the
# server at them (the only other lookup is a "bsps" dir relative to
# WorkingDirectory, which is too implicit to rely on). Provision with
#   ./scripts/fetch-bsps.sh /opt/mvd/bsps    (sha-pinned, idempotent)
# and chown them to the service account.
#
# A map with no BSP does NOT error — it yields an EMPTY LOS, and that empty
# result is cached to tier 3 like any other. So if /los was ever served before
# the BSPs existed, those demos keep returning empty until the artifacts are
# dropped: stop the unit, `rm -rf /opt/mvd/cache/artifacts`, start it again
# (tier 3 is lazily recomputed — tiers 1 and 2 are untouched, so nothing is
# re-downloaded or re-parsed).
Environment=MVDA_BSP_DIR=/opt/mvd/bsps

# -auth-dir enables API-key auth; -portal enables the Discord portal (needs
# the three env vars above). Tune -cache-max-bytes / -max-parses to the box;
# -rate-*/-burst-* set the per-key token buckets (user vs service class).
#
# -addr binds loopback ONLY: Caddy is the sole public surface and must run
# on this same box (its XFF rewrite assumes direct backend access is
# impossible). Bind a LAN/all-interfaces address (e.g. :8080) only if you
# know why — a public bind lets callers spoof X-Forwarded-For past Caddy.
#
# UPLOADS (POST /v1/demos) ARE ON BY DEFAULT. The -upload-* / -max-upload-bytes
# flags below are set to their compiled-in defaults explicitly, so this file is
# the whole story rather than half of it. To close the endpoint entirely, set
# -max-upload-bytes 0 (the route stays registered but answers 404
# uploads_disabled). The per-key daily quota applies in auth mode only and is
# held IN MEMORY: a restart resets every key's daily usage to zero, so treat it
# as abuse damping, not a hard guarantee.
ExecStart=/opt/mvd/bin/mvd-api serve \
    -addr 127.0.0.1:8080 \
    -cache-dir /opt/mvd/cache \
    -cache-max-bytes 21474836480 \
    -max-parses 2 \
    -parse-timeout 120s \
    -auth-dir /opt/mvd/auth \
    -rate-user 5 -burst-user 20 \
    -rate-service 50 -burst-service 200 \
    -max-upload-bytes 67108864 \
    -upload-daily-bytes 536870912 \
    -upload-daily-count 50 \
    -portal \
    -portal-base-url https://qw.example.com \
    -log-format json

Restart=on-failure
RestartSec=2s

# --- Hardening --------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# The cache + key store are the only writable paths the service needs.
ReadWritePaths=/opt/mvd/cache /opt/mvd/auth

# Memory ceiling. TUNE TO THE BOX — these values assume >=4 GiB of RAM; on a
# smaller VPS scale them down (and consider -max-parses 1). A cold parse holds
# the demo bytes plus its Result in memory, and -max-parses bounds how many run
# at once, so the peak is roughly max-parses x (demo + result). Uploads mean a
# stranger can now trigger that work, so cap it: without a ceiling the kernel
# OOM killer picks a victim process on the whole box (quite possibly Caddy),
# whereas with one an overrun kills only this unit and Restart=on-failure
# brings it straight back.
MemoryHigh=2G
MemoryMax=3G

[Install]
WantedBy=multi-user.target
