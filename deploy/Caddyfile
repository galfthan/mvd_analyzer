# Caddyfile — reverse proxy for mvd-api + mvd-mcp + the static web app
# (PLAN-hosting D9).
#
# Caddy terminates TLS (automatic HTTPS via Let's Encrypt) and routes by
# path — all three surfaces share one domain:
#
#   /mcp*                        -> localhost:8081  (mvd-mcp, streamable HTTP)
#   /v1/*  /docs*  /openapi.yaml
#   /healthz  /portal*           -> localhost:8080  (mvd-api REST + portal)
#   everything else              -> static files    (mvd-web bundle)
#
# The API prefix list is EXHAUSTIVE on purpose: those five prefixes are
# the complete public route surface of mvd-api (router.go + portal). If
# you add a new top-level path to mvd-api, you MUST extend the @api
# matcher below — otherwise the new route 404s from the file server.
# Prefer new endpoints under /v1/ so the matcher never needs to change.
# The web app must NOT claim these prefixes for its own assets.
#
# X-Forwarded-For is rewritten to the REAL client IP so mvd-api's access
# log (middleware.go clientIP) records the caller, not Caddy.
#
# EDIT: set MVD_DOMAIN in the environment (or replace {$MVD_DOMAIN} with
# your domain literal). Point DNS A/AAAA at this host first; Caddy
# provisions the certificate on first request.
#
#   MVD_DOMAIN=qw.example.com caddy run --config /etc/caddy/Caddyfile
#
# Port map (must match the systemd units in this directory):
#   mvd-api  -> localhost:8080   (REST, portal, /v1/auth/check)
#   mvd-mcp  -> localhost:8081   (MCP streamable HTTP at /mcp)
# Web root (must match the publish step in README.md):
#   /opt/mvd/web                 (mvd-web `make build` output)

{$MVD_DOMAIN} {
	# --- MCP streamable HTTP --------------------------------------------
	# mvd-mcp serves the handler at exactly /mcp (and /mcp/); the path is
	# passed through unchanged (no strip), matching mcp_http.go's mcpPath.
	# The MCP server's own /healthz is NOT proxied here (only /mcp* is);
	# probe it directly on localhost:8081/healthz from the host. Public
	# /healthz below routes to mvd-api.
	handle /mcp* {
		reverse_proxy localhost:8081 {
			# Overwrite XFF with the direct client IP Caddy observed, so a
			# spoofed inbound X-Forwarded-For cannot survive to the backend.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# --- OAuth discovery probes -----------------------------------------
	# MCP clients (claude.ai connectors, MCP inspector) probe these
	# well-known paths when a server is added. Left alone they fall through
	# to the file server, whose 404 has no WWW-Authenticate header — which
	# is what we want ("no OAuth here, connect anonymously") — but keep the
	# explicit 404s so the behaviour doesn't silently change if a web
	# build ever ships files under /.well-known/.
	handle /.well-known/oauth-authorization-server* {
		respond 404
	}
	handle /.well-known/oauth-protected-resource* {
		respond 404
	}
	handle /.well-known/openid-configuration* {
		respond 404
	}

	# --- REST API + docs + Discord portal -------------------------------
	# The complete mvd-api surface; see the header comment before adding
	# to this list.
	@api path /v1/* /docs /docs/* /openapi.yaml /healthz /portal /portal/*
	handle @api {
		reverse_proxy localhost:8080 {
			# Same XFF rewrite: mvd-api's clientIP() trusts the FIRST XFF
			# entry (middleware.go), so it must be the real client, set by
			# the trusted edge (this Caddy), never an inbound spoof.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# --- Web app (static mvd-web bundle) --------------------------------
	# Everything else serves the `make build` output published to
	# /opt/mvd/web (index.html, app.js, analyzer.wasm, maps/, locs/,
	# bsps/, …). The app routes via query params (?gameId=…), not paths,
	# so a plain file server is enough — no SPA index.html fallback.
	# encode is scoped here (not site-wide): analyzer.wasm and the map
	# geometry are multi-MB and compress well; /mcp* stays uncompressed
	# because compressing its SSE stream can break event flushing, and
	# API clients negotiate with mvd-api directly.
	# If /opt/mvd/web is absent this block 404s; the API above is
	# unaffected.
	handle {
		root * /opt/mvd/web
		encode zstd gzip
		file_server
	}

	# Access log to stdout (journald captures it under the caddy unit).
	log {
		output stdout
		format console
	}
}
