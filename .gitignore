dist/
*.wasm

# Local working directory for cmd/mapgen — community BSP downloads (~1.5 GB).
# Only the generated JSON under internal/web/static/maps/ is committed.
/maps/

# BSP files for the locvis visibility filter. Populated by `make bsps`
# from public mirrors; never committed. See scripts/fetch-bsps.sh.
/bsps/

# MVD demos pulled from hub.quakeworld.nu by the golden test harness.
# The corpus.json manifest references them by gameId; demos are fetched
# on first run and cached here. Bytes themselves are never committed.
mvd-analytics/testdata/cache/

# Local-only golden demos (corpus.json `file` entries) — demos the hub
# doesn't have (pre-instrumentation archive era). Never committed; the
# golden and order tests skip an entry when its demo is absent. The
# committed golden JSON stays; provenance (archive sha256) lives in
# corpus.json so the demo can be re-obtained on request.
mvd-analytics/testdata/demos/

# Emacs autosave / lock files.
**/#*#
**/.#*

# compiled binaries accidentally buildable in-tree
mvd-mcp/mvd-mcp
mvd-web/wasm

# Local production runbook — real deployment topology, deliberately not published.
DEPLOY-HETZNER.md

# Local planning docs (plan/spec files for in-flight work) — per-machine, never committed.
plans/
